    "/api/v1/artifacts/{artifact_id}/content": {
      "get": {
        "description": "Artifactの実ファイルを配信する。候補比較のプレビューに使う。\n\n画面へ渡すのは`artifact_id`だけとし、保存先の絶対パスを外へ出さない。パスの解決は\n`storage`へ閉じ、`data_root`の外は配信しない。",
        "operationId": "get_artifact_content_api_v1_artifacts__artifact_id__content_get",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "title": "Artifact Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Artifact Content"
      }
    },
    "/api/v1/artifacts/{artifact_id}/decision": {
      "patch": {
        "description": "生成候補の採否を記録する。`undecided`へ戻すと判断時刻も消す。",
        "operationId": "update_artifact_decision_api_v1_artifacts__artifact_id__decision_patch",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "title": "Artifact Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArtifactDecisionUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Artifact Decision"
      }
    },
    "/api/v1/generation-jobs": {
      "get": {
        "description": "キュー状態の確認用。既定はqueue_sequence昇順、指定した条件で絞り込む。\n\n`scene_id`と`shot_id`は`scene_ref`/`shot_ref`の`id`と突き合わせる。画面が特定の\nShotの生成履歴だけを見るために使う。",
        "operationId": "list_generation_jobs_api_v1_generation_jobs_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
