  "info": {
    "title": "MyComfyUI Application API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/approval-logs": {
      "post": {
        "operationId": "create_approval_log_api_v1_approval_logs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalLogCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalLogRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Approval Log"
      }
    },
    "/api/v1/approval-logs/{approval_log_id}": {
      "get": {
        "operationId": "get_approval_log_api_v1_approval_logs__approval_log_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "approval_log_id",
            "required": true,
            "schema": {
              "title": "Approval Log Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalLogRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Approval Log"
      }
    },
    "/api/v1/artifacts": {
      "post": {
        "operationId": "create_artifact_api_v1_artifacts_post",
