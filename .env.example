# MyComfyUI Application API の利用者設定例。
# このファイルをリポジトリ直下へ `.env` としてコピーし、必要な値だけを書き換える。
# `.env` は追跡対象外とする。設定値に API キーなどの秘密情報を置かない。
#
# 記載した値はすべて既定値のため、コピーしただけでも Application API は起動する。
# Remote GPU ホスト構成で書き換えるのは接続先だけとする。該当箇所は「Remote 構成」と注記する。
# 変数の一覧と意味は apps/api/README.md、既定値の正本は
# apps/api/src/mycomfyui_api/settings.py の Settings とする。

# 生成履歴とデータベースの保存先。
# 未設定の場合は OS 標準の利用者データ領域を使う。通常は設定しなくてよい。
# SQLite は <data_root>/db/mycomfyui.sqlite3 へ作成される。
# 設定する場合は、自分が書き込めるディレクトリの絶対パスへ書き換える。
#MYCOMFYUI_DATA_ROOT=

# ComfyUI のエンドポイントと 1 Job の実行上限(秒)。
# Remote 構成: base URL を Remote PC へ向け、転送分の余裕を見て上限を伸ばす。
#   MYCOMFYUI_COMFYUI_BASE_URL=http://<remote>:8188
#   MYCOMFYUI_COMFYUI_TIMEOUT_SECONDS=900
# 手順は docs/operations/remote-gpu-host.md、判断の根拠は docs/adr/0002-remote-gpu-host.md を参照する。
MYCOMFYUI_COMFYUI_BASE_URL=http://127.0.0.1:8188
MYCOMFYUI_COMFYUI_TIMEOUT_SECONDS=600

# ai-media 参照 API の接続先。
# 未設定の間は同梱 fixture を返す。上流が動いたらここだけを差し替える。
#MYCOMFYUI_AIMEDIA_BASE_URL=
# 参照 fixture の差し替え先。Canon が更新された状態を手元で再現するときだけ設定する。
#MYCOMFYUI_AIMEDIA_FIXTURE_PATH=

# voice-runner のエンドポイントと 1 台詞あたりの実行上限(秒)。
# Remote 構成: base URL を Remote PC へ向ける。実行経路は分岐しない。
MYCOMFYUI_VOICE_RUNNER_BASE_URL=http://127.0.0.1:8770
MYCOMFYUI_VOICE_RUNNER_TIMEOUT_SECONDS=300

# 取り込む参照画像とガイド音声の上限バイト数。
MYCOMFYUI_MAX_IMAGE_BYTES=33554432
# 取り込む参照音声と受け取る生成音声の上限バイト数。
MYCOMFYUI_VOICE_MAX_AUDIO_BYTES=33554432

# 合成は手元 PC の ffmpeg で実行する。PATH 上の名前でも絶対パスでもよい。
MYCOMFYUI_FFMPEG_PATH=ffmpeg
MYCOMFYUI_FFPROBE_PATH=ffprobe
MYCOMFYUI_COMPOSE_TIMEOUT_SECONDS=600

# Backend を立てずに経路だけ確かめる場合の stub。常用しないため既定 (false) のままにする。
# 経路の確認は true にする。
#MYCOMFYUI_COMFYUI_STUB=false
#MYCOMFYUI_VOICE_STUB=false
# 失敗時の記録の確認は true にする。
#MYCOMFYUI_COMFYUI_STUB_FAILURE=false
#MYCOMFYUI_VOICE_STUB_FAILURE=false
