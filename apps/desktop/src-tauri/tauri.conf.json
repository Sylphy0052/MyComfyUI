{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyComfyUI",
  "version": "0.1.0",
  "identifier": "io.github.sylphy0052.mycomfyui",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev --workspace @mycomfyui/web",
      "cwd": "../../.."
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": {
      "script": "npm run build --workspace @mycomfyui/web",
      "cwd": "../../.."
    },
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mycomfyui-api"]
  }
}
